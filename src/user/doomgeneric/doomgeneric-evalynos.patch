diff --git a/doomgeneric/doomgeneric_evalynos.c b/doomgeneric/doomgeneric_evalynos.c
new file mode 100644
index 0000000..9c6f9dd
--- /dev/null
+++ b/doomgeneric/doomgeneric_evalynos.c
@@ -0,0 +1,216 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "doomkeys.h"
+#include "doomgeneric.h"
+
+static long syscall(int syscall_type, long a) {
+    long ret;
+    __asm__ volatile (
+        "syscall"
+        : "=a"(ret)
+        : "a"(syscall_type), "b"(a)
+        : "rcx", "r11", "memory"
+    );
+    return ret;
+}
+
+int get_pit_cycles() {
+    return syscall(22, 0);
+}
+
+char get_key_press() {
+    return syscall(40, 0);
+}
+
+uint64_t frameBufferBase = 0x00000000A0000000; // setup_fb() makes the kernel map the frame buffer here
+uint32_t frameBufferPitch;
+
+void setup_fb() {
+    syscall(30, 0);
+}
+
+int get_pitch() {
+    return syscall(31, 0);
+}
+
+void plotPixel(int x, int y, int color) {
+    *((volatile uint32_t*)frameBufferBase + y * (frameBufferPitch >> 2) + x) = color;
+}
+
+uint32_t inital_ms;
+
+void DG_Init() {
+    setup_fb();
+    frameBufferPitch = get_pitch();
+
+    inital_ms = get_pit_cycles();
+
+    while (get_key_press()) {
+
+    }
+}
+
+#define KEYBUF_SIZE 64
+
+typedef struct {
+    unsigned char scancode;
+    int pressed;
+    int extended;
+} KeyEvent;
+
+static KeyEvent keybuf[KEYBUF_SIZE];
+static int keybuf_head = 0;
+static int keybuf_tail = 0;
+
+static int keybuf_empty(void) {
+    return keybuf_head == keybuf_tail;
+}
+
+static int keybuf_full(void) {
+    return ((keybuf_head + 1) % KEYBUF_SIZE) == keybuf_tail;
+}
+
+static void keybuf_push(unsigned char scancode, int pressed, int extended) {
+    if (keybuf_full())
+        return;
+
+    keybuf[keybuf_head].scancode = scancode;
+    keybuf[keybuf_head].pressed  = pressed;
+    keybuf[keybuf_head].extended  = extended;
+    keybuf_head = (keybuf_head + 1) % KEYBUF_SIZE;
+}
+
+static int keybuf_pop(KeyEvent* ev) {
+    if (keybuf_empty())
+        return 0;
+
+    *ev = keybuf[keybuf_tail];
+    keybuf_tail = (keybuf_tail + 1) % KEYBUF_SIZE;
+    return 1;
+}
+
+void pollKeyboard() {
+    unsigned char scancode = get_key_press();
+    if (!scancode)
+        return;
+
+    int extended = 0;
+
+    if (scancode == 0xE0) {
+        while ((scancode = get_key_press()) == 0) {}
+        extended = 1;
+    }
+
+    int pressed = !(scancode & 0x80);
+    scancode &= 0x7F;
+
+    keybuf_push(scancode, pressed, extended);
+}
+
+int DG_GetKey(int* pressed, unsigned char* doomKey) {
+    KeyEvent ev;
+
+    if (!keybuf_pop(&ev))
+        return 0;
+
+    *pressed = ev.pressed;
+
+    unsigned char scancode = ev.scancode;
+    int isExtended = ev.extended;
+
+    if (isExtended) {
+        switch (scancode) {
+            case 0x48: *doomKey = KEY_UPARROW;    return 1;
+            case 0x50: *doomKey = KEY_DOWNARROW;  return 1;
+            case 0x4B: *doomKey = KEY_LEFTARROW;  return 1;
+            case 0x4D: *doomKey = KEY_RIGHTARROW; return 1;
+            case 0x1D: *doomKey = KEY_RCTRL;      return 1;
+            case 0x38: *doomKey = KEY_RALT;       return 1;
+
+            default:                              return 0;
+        }
+    } else {
+        switch (scancode) {
+            case 0x01: *doomKey = KEY_ESCAPE;     return 1;
+            case 0x1C: *doomKey = KEY_ENTER;      return 1;
+            case 0x39: *doomKey = KEY_USE;        return 1;
+            case 0x1D: *doomKey = KEY_FIRE;       return 1;
+            case 0x38: *doomKey = KEY_LALT;       return 1;
+            case 0x2A: *doomKey = KEY_RSHIFT;     return 1;
+            case 0x36: *doomKey = KEY_RSHIFT;     return 1;
+            case 0x0F: *doomKey = KEY_TAB;        return 1;
+
+            case 0x02: *doomKey = '1';            return 1;
+            case 0x03: *doomKey = '2';            return 1;
+            case 0x04: *doomKey = '3';            return 1;
+            case 0x05: *doomKey = '4';            return 1;
+            case 0x06: *doomKey = '5';            return 1;
+            case 0x07: *doomKey = '6';            return 1;
+            case 0x08: *doomKey = '7';            return 1;
+            case 0x09: *doomKey = '8';            return 1;
+            case 0x0A: *doomKey = '9';            return 1;
+            case 0x0B: *doomKey = '0';            return 1;
+
+            case 0x0D: *doomKey = '=';            return 1;
+            case 0x0C: *doomKey = '-';            return 1;
+            case 0x21: *doomKey = 'f';            return 1;
+            case 0x32: *doomKey = 'm';            return 1;
+            case 0x2E: *doomKey = 'c';            return 1;
+            case 0x18: *doomKey = 'o';            return 1;
+
+            case 0x3B: *doomKey = KEY_F1;         return 1;
+            case 0x3C: *doomKey = KEY_F2;         return 1;
+            case 0x3D: *doomKey = KEY_F3;         return 1;
+            case 0x3E: *doomKey = KEY_F4;         return 1;
+            case 0x3F: *doomKey = KEY_F5;         return 1;
+            case 0x40: *doomKey = KEY_F6;         return 1;
+            case 0x41: *doomKey = KEY_F7;         return 1;
+            case 0x42: *doomKey = KEY_F8;         return 1;
+            case 0x43: *doomKey = KEY_F9;         return 1;
+            case 0x44: *doomKey = KEY_F10;        return 1;
+            case 0x57: *doomKey = KEY_F11;        return 1;
+            case 0x58: *doomKey = KEY_F12;        return 1;
+
+            default:                              return 0;
+        }
+    }
+}
+
+void DG_DrawFrame() {
+    pollKeyboard();
+    uint32_t *dstBase = (uint32_t *)frameBufferBase;
+    int dstStride = frameBufferPitch >> 2;
+
+    for (int y = 0; y < DOOMGENERIC_RESY; y++) {
+        uint32_t *dst = dstBase + (y * dstStride) + 600;
+        uint32_t *src = (uint32_t *)&DG_ScreenBuffer[y * DOOMGENERIC_RESX];
+        memcpy(dst, src, DOOMGENERIC_RESX * sizeof(uint32_t));
+    }
+}
+
+void DG_SleepMs(uint32_t ms) {
+    int start = get_pit_cycles();
+    int end = start + ms;
+    while (get_pit_cycles() < end) {
+    }
+}
+
+uint32_t DG_GetTicksMs() {
+    return get_pit_cycles() - inital_ms;
+}
+
+void DG_SetWindowTitle(const char * title) {
+    printf("Window Title: %s\n", title);
+}
+
+int main(int argc, char **argv) {
+    doomgeneric_Create(argc, argv);
+
+    while (1) {
+        doomgeneric_Tick();
+    }
+
+    return 0;
+}
