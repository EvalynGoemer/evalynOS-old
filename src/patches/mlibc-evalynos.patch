+#include "mlibc/tcb.hpp"
+#include <abi-bits/errno.h>
+#include <bits/ensure.h>
+#include <mlibc/all-sysdeps.hpp>
+#include <string.h>
+
+#define SYS_GET_THREAD_ID 0
+#define SYS_PRINT 1
+#define SYS_SET_FSBASE 2
+#define SYS_MMAP 3
+
+uint64_t syscall1(uint64_t syscall_type, uint64_t rbx) {
+    uint64_t ret;
+    __asm__ volatile (
+        "syscall"
+        : "=a"(ret)
+        : "a"(syscall_type), "b"(rbx)
+        : "rcx", "r11", "memory"
+    );
+    return ret;
+}
+
+uint64_t syscall2(int syscall_type, uint64_t rbx, uint64_t rdx) {
+    uint64_t ret;
+    __asm__ volatile (
+        "syscall"
+        : "=a"(ret)
+        : "rax"(syscall_type), "b"(rbx), "d"(rdx)
+        : "rcx", "r11", "memory"
+    );
+    return ret;
+}
+
+void syscall_print(const char* string) {
+    syscall1(SYS_PRINT, (long)string);
+}
+
+void syscall_write_fsbase(long fsbase) {
+    syscall1(SYS_SET_FSBASE, fsbase);
+}
+
+#define STUB()                                                                 \
+({                                                                             \
+    __ensure(!"STUB function was called");                                     \
+    __builtin_unreachable();                                                   \
+})
+
+namespace mlibc {
+
+    void sys_libc_panic() {
+        sys_libc_log("!!! mlibc panic !!!\n");
+        sys_exit(-1);
+        __builtin_trap();
+    }
+
+    void sys_libc_log(const char *msg) {
+        syscall_print(msg);
+    }
+
+    int sys_isatty(int fd) {
+        (void)fd;
+        return 0;
+    }
+
+    int sys_write(int fd, void const *buf, size_t size, ssize_t *ret) {
+        (void)fd;
+        syscall_print((char *)buf);
+        *ret = size;
+        return 0;
+    }
+
+    int sys_tcb_set(void *pointer) {
+        syscall_write_fsbase((uint64_t)pointer);
+        return 0;
+    }
+
+    int sys_anon_allocate(size_t size, void **pointer) {
+        uint64_t out = syscall1(SYS_MMAP, size);
+
+        if (out == 0)
+            return ENOMEM;
+
+        *pointer = (void *)out;
+        return 0;
+    }
+
+    int sys_anon_free(void *, unsigned long) { return 0; }
+
+    int sys_seek(int , off_t , int , off_t *) {
+        return ESPIPE;
+    }
+
+    void sys_exit(int status) {
+        (void)status;
+        while (1) {
+
+        }
+        __builtin_unreachable();
+    }
