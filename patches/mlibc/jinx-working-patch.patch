+#pragma once
+
+#include <mlibc/sysdep-signatures.hpp>
+
+namespace mlibc {
+
+struct EvalynosSysdepTags : LibcPanic,
+                            LibcLog,
+                            Isatty,
+                            Write,
+                            TcbSet,
+                            AnonAllocate,
+                            AnonFree,
+                            Seek,
+                            Exit,
+                            Close,
+                            FutexWake,
+                            FutexWait,
+                            Read,
+                            Open,
+                            Stat,
+                            VmMap,
+                            VmUnmap,
+                            ClockGet,
+                            Dup,
+                            Dup2,
+                            Ioctl,
+                            Mkdir,
+                            GetUid,
+                            GetEuid,
+                            GetGid,
+                            GetEgid,
+                            GetPid,
+                            GetPpid,
+                            GetPgid,
+                            SetPgid,
+                            GetResuid,
+                            GetResgid,
+                            Tcgetwinsize,
+                            GetHostname,
+                            Sigaction,
+                            Tcgetattr,
+                            Tcsetattr,
+                            Ttyname,
+                            Sigprocmask,
+                            Fcntl,
+                            Sysconf,
+                            GetCwd{};
+
+template <typename Tag>
+using Sysdeps = SysdepOf<EvalynosSysdepTags, Tag>;
+
+} // namespace mlibc
